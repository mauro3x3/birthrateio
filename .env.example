# ---------------------------------------------------------------------------
# birthrate.io environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database connection — PostgreSQL (Neon / Supabase / Vercel Postgres).
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL:   direct (non-pooled) connection used for migrations / db push.
# On Neon, DATABASE_URL is the "Pooled connection" string and DIRECT_URL is the
# plain one. If your host has no pooler, set both to the same value.
DATABASE_URL="postgresql://USER:PASS@HOST/birthrateio?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST/birthrateio?sslmode=require"

# Public site URL — used for canonical links, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (Vercel): set this to https://birthrate.io — if missing, production
# still defaults to https://birthrate.io so the sitemap never emits localhost.

# Optional: secret to protect the cron ingestion endpoint (/api/cron/ingest).
CRON_SECRET=""

# Optional Mapbox token (used elsewhere in the app).
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Optional CARTO basemap key (free at carto.com/basemaps/apikey). If unset,
# point maps use Esri dark canvas tiles instead.
NEXT_PUBLIC_CARTO_API_KEY=""

# AI assistant (the "mascot"). Server-side only — never exposed to the client.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: donation page link (Buy Me a Coffee, Ko-fi, Stripe, PayPal, etc.).
# Defaults to the project's Buy Me a Coffee page when unset.
NEXT_PUBLIC_DONATION_URL="https://buymeacoffee.com/kinderheimrune"

# PostHog analytics (https://us.posthog.com). Set in Vercel env for production.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Optional — paste the Google Search Console HTML-tag verification token
# (just the content value, not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
